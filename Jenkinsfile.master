pipeline {
    agent any
    environment {
        SONAR_TOKEN = credentials('sonarqube-token')
        TFE_TOKEN   = credentials('tfe-token')
        REPO_URL = 'https://github.com/JuliianaV2106/circle-guard-public.git'
        STAGE_NAMESPACE = 'circleguard-stage'
        MASTER_NAMESPACE = 'circleguard-master'
        VERSION = "1.0.${BUILD_NUMBER}"
    }
    stages {
        stage('Checkout') {
            steps {
                git url: "${REPO_URL}", branch: 'master'
            }
        }

        stage('Build') {
            steps {
                sh './gradlew clean build -x test --no-daemon'
            }
        }

        stage('Unit Tests') {
            steps {
                sh '''./gradlew cleanTest test --no-daemon \
                    -x :services:circleguard-notification-service:test \
                    -x :services:circleguard-promotion-service:test'''
            }
            post {
                always {
                    junit '**/build/test-results/test/*.xml'
                }
            }
        }

        stage('Static Analysis') {
            steps {
                withSonarQubeEnv('sonarqube') {
                    sh '''./gradlew sonar --no-daemon \
                        -Dsonar.projectKey=circle-guard \
                        -Dsonar.host.url=http://sonarqube:9000 \
                        -Dsonar.token=${SONAR_TOKEN}'''
                }
            }
        }

        stage('Docker Build') {
            steps {
                script {
                    def services = [
                        'auth-service',
                        'gateway-service',
                        'identity-service',
                        'form-service',
                        'notification-service',
                        'dashboard-service'
                    ]
                    for (service in services) {
                        sh "docker build -f Dockerfile.${service} -t circleguard/${service}:${VERSION} -t circleguard/${service}:latest ."
                    }
                }
            }
        }

        stage('Security Scan') {
            steps {
                script {
                    def services = [
                        'gateway-service',
                        'notification-service'
                    ]
                    for (service in services) {
                        sh "trivy image --exit-code 0 --severity HIGH,CRITICAL --format table circleguard/${service}:latest"
                    }
                }
            }
        }

        stage('Deploy to Stage (Terraform)') {
            steps {
                script {
                    dir('terraform/environments/stage') {
                        sh "terraform init"
                        sh "terraform apply -auto-approve -var-file=stage.tfvars"
                        sh "kubectl rollout status deployment/gateway-service -n ${STAGE_NAMESPACE} --timeout=120s"
                        echo 'Deploy to STAGE complete'
                    }
                }
            }
        }

        stage('System Tests on Stage') {
            steps {
                script {
                    sleep(15)
                    echo 'Running system tests against STAGE...'
                    sh """
                        STATUS=\$(curl -s -o /dev/null -w "%{http_code}" \
                        -X POST http://host.docker.internal:31450/api/v1/gate/validate \
                        -H 'Content-Type: application/json' \
                        -d '{"token": "system-test-token"}' \
                        || echo '000')
                        echo "System test - Gateway status: \$STATUS"
                    """
                    sh """
                        PODS=\$(kubectl get pods -n ${STAGE_NAMESPACE} --field-selector=status.phase=Running --no-headers | wc -l)
                        echo "Running pods in STAGE: \$PODS"
                    """
                    echo 'System tests completed'
                }
            }
        }

        stage('Approval') {
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input message: 'Aprobar despliegue a MASTER?',
                        ok: 'Aprobar',
                        submitter: 'admin',
                        parameters: [
                            string(
                                name: 'DEPLOYMENT_NOTES',
                                defaultValue: '',
                                description: 'Notas del despliegue (opcional)'
                            )
                        ]
                }
            }
        }

        stage('Deploy to Master (Terraform)') {
            steps {
                script {
                    dir('terraform/environments/master') {
                        sh "terraform init"
                        sh "terraform apply -auto-approve -var-file=master.tfvars"
                        sh "kubectl rollout status deployment/gateway-service -n ${MASTER_NAMESPACE} --timeout=120s"
                        echo 'Deploy to MASTER complete'
                    }
                }
            }
        }

        stage('Generate Release Notes') {
            steps {
                script {
                    def date = new Date().format('yyyy-MM-dd')
                    def releaseNotes = """# Release Notes — Circle Guard v${VERSION}

**Fecha de release:** ${date}
**Build:** #${BUILD_NUMBER}
**Branch:** master
**Ambiente:** Production (circleguard-master)

## Servicios desplegados

| Servicio | Imagen | Namespace |
|---------|--------|-----------|
| gateway-service | circleguard/gateway-service:${VERSION} | circleguard-master |
| notification-service | circleguard/notification-service:${VERSION} | circleguard-master |

## Pipeline ejecutado

| Etapa | Estado |
|-------|--------|
| Build | Exitoso |
| Unit Tests | Exitoso |
| Static Analysis (SonarQube) | Exitoso |
| Docker Build | Imágenes construidas |
| Security Scan (Trivy) | Escaneado |
| Deploy Stage | circleguard-stage |
| System Tests | Exitoso |
| Deploy Master | circleguard-master |

## Commits incluidos

\$(git log --oneline -10 || echo 'No git history available')

## Vulnerabilidades conocidas

- Apache Tomcat 10.1.19 — CVE-2025-24813 (CRITICAL) — Fix: actualizar a 10.1.35+
- Apache Tomcat 10.1.19 — CVE-2026-29145 (CRITICAL) — Fix: actualizar a 10.1.53+
- Spring Boot 3.2.4 — múltiples HIGH — Fix: actualizar a 3.3.11+

## Change Management

- **Tipo:** Release de funcionalidad
- **Impacto:** Bajo — servicios gateway y notification
- **Rollback:** kubectl rollout undo deployment/gateway-service -n circleguard-master
- **Aprobado por:** Pipeline automático CI/CD

---
*Generado automáticamente por Jenkins Pipeline — Build #${BUILD_NUMBER}*
"""
                    writeFile file: "RELEASE-NOTES-v${VERSION}.md", text: releaseNotes
                    echo "Release Notes generadas: RELEASE-NOTES-v${VERSION}.md"
                    sh "cat RELEASE-NOTES-v${VERSION}.md"
                    archiveArtifacts artifacts: "RELEASE-NOTES-v${VERSION}.md"
                }
            }
        }
    }
    post {
        always {
            echo 'Pipeline finalizado'
            cleanWs()
        }
        success {
            echo 'Pipeline EXITOSO'
            emailext(
                subject: "SUCCESS: Circle Guard Pipeline - Build #${BUILD_NUMBER}",
                body: """
                    <h2>Pipeline Exitoso</h2>
                    <p><b>Job:</b> ${JOB_NAME}</p>
                    <p><b>Build:</b> #${BUILD_NUMBER}</p>
                    <p><b>Branch:</b> ${GIT_BRANCH}</p>
                    <p><b>URL:</b> <a href="${BUILD_URL}">${BUILD_URL}</a></p>
                    <p>Todos los stages completaron exitosamente.</p>
                """,
                mimeType: 'text/html',
                to: 'juliianavalenciia21@gmail.com'            )
        }
        failure {
            echo 'Pipeline FALLIDO'
            emailext(
                subject: "FAILED: Circle Guard Pipeline - Build #${BUILD_NUMBER}",
                body: """
                    <h2>Pipeline Fallido</h2>
                    <p><b>Job:</b> ${JOB_NAME}</p>
                    <p><b>Build:</b> #${BUILD_NUMBER}</p>
                    <p><b>Branch:</b> ${GIT_BRANCH}</p>
                    <p><b>URL:</b> <a href="${BUILD_URL}">${BUILD_URL}</a></p>
                    <p>Revisa el console output para ver el error.</p>
                """,
                mimeType: 'text/html',
                to: '${DEFAULT_RECIPIENTS}'
            )
        }
    }
}