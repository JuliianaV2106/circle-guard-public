pipeline {
    agent any
    environment {
        SONAR_TOKEN = credentials('sonarqube-token')
        TFE_TOKEN   = credentials('tfetoken')
        GIT_CREDENTIALS = credentials('github-token')
        REPO_URL = 'https://github.com/JuliianaV2106/circle-guard-public.git'
        STAGE_NAMESPACE = 'circleguard-stage'
        MASTER_NAMESPACE = 'circleguard-master'
    }
    stages {
        stage('Checkout') {
            steps {
                git url: "${REPO_URL}", branch: 'master'
            }
        }

        stage('Semantic Versioning') {
            steps {
                script {
                    sh 'git fetch --tags'
                    def latestTag = sh(script: 'git describe --tags --match "v*.*.*" $(git rev-list --tags --max-count=1) 2>/dev/null || echo "v1.0.0"', returnStdout: true).trim()
                    echo "Latest tag: ${latestTag}"

                    def parts = latestTag.replace('v', '').split('\\.')
                    def major = parts[0] as Integer
                    def minor = parts[1] as Integer
                    def patch = parts[2] as Integer

                    env.MAJOR = "${major}"
                    env.MINOR = "${minor}"
                    env.PATCH = "${patch + 1}"
                    env.VERSION = "${major}.${minor}.${patch + 1}"

                    echo "Semantic version: v${env.VERSION}"
                    sh "echo version=${env.VERSION} > version.properties"
                    sh "git add version.properties && git commit -m 'chore: update version.properties to v${env.VERSION}' || true"
                    sh "git push https://${GIT_CREDENTIALS_USR}:${GIT_CREDENTIALS_PSW}@github.com/JuliianaV2106/circle-guard-public.git master"
                }
            }
        }

        stage('Build') {
            steps {
                sh './gradlew clean build -x test --no-daemon'
            }
        }

        stage('Unit Tests') {
            steps {
                sh '''./gradlew cleanTest test --no-daemon \
                    -x :services:circleguard-notification-service:test \
                    -x :services:circleguard-promotion-service:test'''
            }
            post {
                always {
                    junit '**/build/test-results/test/*.xml'
                }
            }
        }

        stage('Static Analysis') {
            steps {
                withSonarQubeEnv('sonarqube') {
                    sh '''./gradlew sonar --no-daemon \
                        -Dsonar.projectKey=circle-guard \
                        -Dsonar.host.url=http://sonarqube:9000 \
                        -Dsonar.token=${SONAR_TOKEN}'''
                }
            }
        }

        stage('Docker Build') {
            steps {
                script {
                    def services = [
                        'auth-service',
                        'gateway-service',
                        'identity-service',
                        'form-service',
                        'notification-service',
                        'dashboard-service'
                    ]
                    for (service in services) {
                        sh "docker build -f Dockerfile.${service} -t circleguard/${service}:${VERSION} -t circleguard/${service}:latest ."
                    }
                }
            }
        }

        stage('Security Scan') {
            steps {
                script {
                    def services = [
                        'gateway-service',
                        'notification-service'
                    ]
                    for (service in services) {
                        sh "trivy image --exit-code 0 --severity HIGH,CRITICAL --format table circleguard/${service}:latest"
                    }
                }
            }
        }

        stage('OWASP ZAP Scan') {
            steps {
                script {
                    sh '''
                        chmod +x scripts/zap-scan.sh
                        ./scripts/zap-scan.sh http://host.docker.internal:31450 build/reports/zap || echo "ZAP scan completed"
                    '''
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'build/reports/zap/*', allowEmptyArchive: true
                }
            }
        }

        stage('Deploy to Stage (Terraform)') {
            steps {
                script {
                    dir('terraform/environments/stage') {
                        sh "terraform init"
                        sh "terraform apply -auto-approve -var-file=stage.tfvars"
                        sh "kubectl rollout status deployment/gateway-service -n ${STAGE_NAMESPACE} --timeout=120s"
                        echo 'Deploy to STAGE complete'
                    }
                }
            }
        }

        stage('System Tests on Stage') {
            steps {
                script {
                    sleep(15)
                    echo 'Running system tests against STAGE...'
                    sh """
                        STATUS=\$(curl -s -o /dev/null -w "%{http_code}" \
                        -X POST http://host.docker.internal:31450/api/v1/gate/validate \
                        -H 'Content-Type: application/json' \
                        -d '{"token": "system-test-token"}' \
                        || echo '000')
                        echo "System test - Gateway status: \$STATUS"
                    """
                    sh """
                        PODS=\$(kubectl get pods -n ${STAGE_NAMESPACE} --field-selector=status.phase=Running --no-headers | wc -l)
                        echo "Running pods in STAGE: \$PODS"
                    """
                    echo 'System tests completed'
                }
            }
        }

        stage('Approval') {
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input message: 'Aprobar despliegue a MASTER?',
                        ok: 'Aprobar',
                        submitter: 'admin',
                        parameters: [
                            string(
                                name: 'DEPLOYMENT_NOTES',
                                defaultValue: '',
                                description: 'Notas del despliegue (opcional)'
                            )
                        ]
                }
            }
        }

        stage('Deploy to Master (Terraform)') {
            steps {
                script {
                    dir('terraform/environments/master') {
                        sh "terraform init"
                        sh "terraform apply -auto-approve -var-file=master.tfvars"
                        sh "kubectl rollout status deployment/gateway-service -n ${MASTER_NAMESPACE} --timeout=120s"
                        echo 'Deploy to MASTER complete'
                    }
                }
            }
        }

        stage('Generate Release Notes') {
            steps {
                script {
                    sh 'chmod +x scripts/generate-release-notes.sh'
                    sh "scripts/generate-release-notes.sh ${VERSION} RELEASE-NOTES-v${VERSION}.md"
                    archiveArtifacts artifacts: "RELEASE-NOTES-v${VERSION}.md"
                }
            }
        }

        stage('Tag Release') {
            steps {
                script {
                    sh "git config user.email 'cicd@circleguard.com'"
                    sh "git config user.name 'CircleGuard CI/CD'"
                    sh "git tag -a v${VERSION} -m 'Release v${VERSION}'"
                    sh "git push https://${GIT_CREDENTIALS_USR}:${GIT_CREDENTIALS_PSW}@github.com/JuliianaV2106/circle-guard-public.git v${VERSION}"
                    echo "Tag v${VERSION} created and pushed successfully"
                }
            }
        }

        stage('GitHub Release') {
            environment {
                GH_TOKEN = credentials('github-token')
            }
            steps {
                script {
                    sh """
                        echo "${GH_TOKEN}" | gh auth login --with-token
                        gh release create v${VERSION} \
                            --title "Release v${VERSION}" \
                            --notes-file RELEASE-NOTES-v${VERSION}.md \
                            --target master
                    """
                }
            }
        }
    }
    post {
        always {
            echo 'Pipeline finalizado'
            cleanWs()
        }
        success {
            echo 'Pipeline EXITOSO'
            emailext(
                subject: "SUCCESS: Circle Guard Pipeline - Build #${BUILD_NUMBER}",
                body: """
                    <h2>Pipeline Exitoso</h2>
                    <p><b>Job:</b> ${JOB_NAME}</p>
                    <p><b>Build:</b> #${BUILD_NUMBER}</p>
                    <p><b>Branch:</b> ${GIT_BRANCH}</p>
                    <p><b>URL:</b> <a href="${BUILD_URL}">${BUILD_URL}</a></p>
                    <p>Todos los stages completaron exitosamente.</p>
                """,
                mimeType: 'text/html',
                to: 'juliianavalenciia21@gmail.com'            )
        }
        failure {
            echo 'Pipeline FALLIDO'
            emailext(
                subject: "FAILED: Circle Guard Pipeline - Build #${BUILD_NUMBER}",
                body: """
                    <h2>Pipeline Fallido</h2>
                    <p><b>Job:</b> ${JOB_NAME}</p>
                    <p><b>Build:</b> #${BUILD_NUMBER}</p>
                    <p><b>Branch:</b> ${GIT_BRANCH}</p>
                    <p><b>URL:</b> <a href="${BUILD_URL}">${BUILD_URL}</a></p>
                    <p>Revisa el console output para ver el error.</p>
                """,
                mimeType: 'text/html',
                to: '${DEFAULT_RECIPIENTS}'
            )
        }
    }
}