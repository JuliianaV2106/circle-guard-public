{
  "title": "CircleGuard - Service Health",
  "uid": "circleguard-services",
  "version": 1,
  "timezone": "browser",
  "schemaVersion": 36,
  "tags": ["circleguard", "services", "health"],
  "panels": [
    {
      "title": "Service Health Overview",
      "type": "stat",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(up{job=~\"auth-service|gateway-service|identity-service|form-service|notification-service|dashboard-service|file-service|promotion-service\"})",
          "legendFormat": "Services Up"
        }
      ],
      "description": "Number of services currently up"
    },
    {
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count[1m])",
          "legendFormat": "{{service}} - {{method}} {{uri}}"
        }
      ],
      "description": "HTTP request rate per service"
    },
    {
      "title": "HTTP Error Rate (4xx/5xx)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{status=~\"4..|5..\"}[1m])",
          "legendFormat": "{{service}} - {{status}}"
        }
      ],
      "description": "HTTP error rate per service"
    },
    {
      "title": "HTTP Response Time (P95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le, service))",
          "legendFormat": "P95 - {{service}}"
        }
      ],
      "description": "95th percentile response time per service"
    },
    {
      "title": "CPU Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "system_cpu_usage",
          "legendFormat": "{{application}} - CPU"
        }
      ],
      "description": "System CPU usage per service"
    }
  ]
}
